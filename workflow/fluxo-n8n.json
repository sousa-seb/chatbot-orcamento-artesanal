    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH atualizadas AS (\n    UPDATE mensagens_debounce\n    SET processado = TRUE\n    WHERE chat_id = {{ $(\"Wait\").item.json.chat_id }}\n      AND message_id <= {{ $json.latest_message_id }}\n      AND processado = FALSE\n    RETURNING id\n)\nSELECT COUNT(*)::int AS mensagens_processadas\nFROM atualizadas;",
